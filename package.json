{
  "name": "hakoniwa-term",
  "version": "0.0.5",
  "description": "A robust, pluggable retro terminal engine for React, powered by CSS Modules and Async Generators.",
  "keywords": [
    "async-generator",
    "cli-ui",
    "css-modules",
    "react",
    "terminal",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/koji/hakoniwa-term",
  "license": "MIT",
  "author": "koji <baxin1919@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koji/hakoniwa-term.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "lucide-react": "^0.470.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.3",
    "vite": "8.1.3",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
